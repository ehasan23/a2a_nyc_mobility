{
  "datasets": [
    {
      "name": "status",
      "displayName": "Release status",
      "queryLines": [
        "SELECT last_certified_at, certified_releases, last_periods FROM v_release_status\n"
      ]
    },
    {
      "name": "daily_hvfhv",
      "displayName": "BQ1 daily trips - HVFHV",
      "queryLines": [
        "SELECT service_date,\n",
        "  concat(crz_segment, CASE WHEN fee_era = 'toll' THEN ' - from 5 Jan (toll)' ELSE ' - before 5 Jan' END) AS series,\n",
        "  sum(trips) AS trips\n",
        "FROM gold_daily_segment WHERE service = 'hvfhv' GROUP BY ALL\n"
      ]
    },
    {
      "name": "daily_yellow",
      "displayName": "BQ1 daily trips - yellow",
      "queryLines": [
        "SELECT service_date,\n",
        "  concat(crz_segment, CASE WHEN fee_era = 'toll' THEN ' - from 5 Jan (toll)' ELSE ' - before 5 Jan' END) AS series,\n",
        "  sum(trips) AS trips\n",
        "FROM gold_daily_segment WHERE service = 'yellow' GROUP BY ALL\n"
      ]
    },
    {
      "name": "bq1",
      "displayName": "BQ1 before vs after",
      "queryLines": [
        "WITH daily AS (\n",
        "  SELECT service_date, service, crz_segment, sum(trips) AS trips FROM gold_daily_segment GROUP BY ALL\n",
        "), win AS (\n",
        "  SELECT *, CASE WHEN service_date BETWEEN DATE'2024-11-01' AND DATE'2024-12-31' THEN 'before'\n",
        "                 WHEN service_date BETWEEN DATE'2025-01-05' AND DATE'2025-02-28' THEN 'after' END AS win\n",
        "  FROM daily\n",
        ")\n",
        "SELECT service, crz_segment AS segment,\n",
        "  round(avg(CASE WHEN win = 'before' THEN trips END)) AS trips_per_day_before,\n",
        "  round(avg(CASE WHEN win = 'after' THEN trips END)) AS trips_per_day_after,\n",
        "  round(100 * (avg(CASE WHEN win = 'after' THEN trips END) / avg(CASE WHEN win = 'before' THEN trips END) - 1), 1) AS pct_change\n",
        "FROM win WHERE win IS NOT NULL GROUP BY ALL ORDER BY service, segment\n"
      ]
    },
    {
      "name": "fee_toll",
      "displayName": "BQ2 fee incidence (toll era)",
      "queryLines": [
        "SELECT platform,\n",
        "  round(100 * sum(trips_with_fee) / sum(trips), 1) AS pct_trips_with_fee,\n",
        "  round(sum(total_cbd_fee) / nullif(sum(trips_with_fee), 0), 2) AS avg_fee\n",
        "FROM gold_fee_summary WHERE service = 'hvfhv' AND fee_era = 'toll' GROUP BY platform\n"
      ]
    },
    {
      "name": "driver_share",
      "displayName": "BQ2 driver share",
      "queryLines": [
        "SELECT concat(platform, ' - ', crz_segment) AS platform_segment,\n",
        "  CASE WHEN fee_era = 'toll' THEN 'after' ELSE 'before' END AS era,\n",
        "  round(sum(total_driver_pay) / sum(total_passenger_fare), 3) AS driver_share\n",
        "FROM gold_fee_summary WHERE service = 'hvfhv' GROUP BY ALL\n"
      ]
    },
    {
      "name": "wait",
      "displayName": "BQ3 p90 wait by hour",
      "queryLines": [
        "SELECT pickup_hour,\n",
        "  concat(platform, CASE WHEN fee_era = 'toll' THEN ' - after' ELSE ' - before' END) AS series,\n",
        "  round(p90_wait_min, 2) AS p90_wait_min\n",
        "FROM gold_wait_era WHERE hour_scope = 'by_hour' AND crz_segment = 'touches_zone'\n"
      ]
    },
    {
      "name": "weather",
      "displayName": "BQ4 trips per day by weather",
      "queryLines": [
        "SELECT concat(period, ' ', service) AS month_service, weather_class,\n",
        "  count(*) AS days, round(avg(trips)) AS trips_per_day\n",
        "FROM gold_weather_demand WHERE weather_class <> 'no_data' GROUP BY ALL\n"
      ]
    }
  ],
